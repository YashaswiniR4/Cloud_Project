# Environment Configuration Template
ENV=development
LOG_LEVEL=INFO
PORT=8000

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AWS Cloud Credentials & Infrastructure Config
AWS_REGION=us-east-1
AWS_DEFAULT_OUTPUT=json
S3_WORM_BUCKET_NAME=threat-intel-worm-audit-vault
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/worm-audit-key
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:SOCAlertsTopic

# Threat Intelligence External APIs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Honeypot Settings
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080

# JWT Authentication Configuration
JWT_SECRET_KEY=soc_super_secret_jwt_key_2026_cloud_threat_intel
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Verification Settings (Gmail / Outlook / Custom SMTP)
# Note: For Gmail, use smtp.gmail.com, port 587 (TLS) or 465 (SSL).
# Enable 2-Step Verification on Gmail and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_SSL=false
