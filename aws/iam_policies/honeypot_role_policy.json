{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudWatchLogsDelivery",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/honeypot/*",
      "Rationale": "Required to stream SSH and HTTP honeypot attack log events to CloudWatch for central SOC aggregation."
    },
    {
      "Sid": "AllowSQSTelemetryStream",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:SendMessageBatch"
      ],
      "Resource": "arn:aws:sqs:us-east-1:123456789012:threat-intel-telemetry-queue",
      "Rationale": "Required for sending real-time honeypot attack vectors asynchronously into the telemetry ingestion queue."
    },
    {
      "Sid": "DenyAllEC2AdminActions",
      "Effect": "Deny",
      "Action": [
        "ec2:Create*",
        "ec2:Delete*",
        "ec2:Authorize*",
        "iam:*"
      ],
      "Resource": "*",
      "Rationale": "Zero Trust Containment Guardrail: Explicitly blocks compromised honeypots from pivoting or altering cloud infrastructure."
    }
  ]
}
