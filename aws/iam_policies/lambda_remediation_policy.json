{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSecurityGroupIpBlocking",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:123456789012:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CloudThreatIntelPlatform"
        }
      },
      "Rationale": "Grants Lambda remediation engine narrow access to alter Security Group ingress rules specifically tagged for the Threat Platform."
    },
    {
      "Sid": "AllowSNSSecurityAlertPublish",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:123456789012:threat-intel-alerts-topic",
      "Rationale": "Enables Lambda to dispatch automated high-severity incident notification messages to the SOC SNS topic."
    }
  ]
}
