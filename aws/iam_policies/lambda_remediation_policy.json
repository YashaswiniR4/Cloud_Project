{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSecurityGroupIpBlocking",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CloudThreatIntelPlatform"
        }
      }
    },
    {
      "Sid": "AllowSNSSecurityAlertPublish",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:*:*:threat-intel-alerts-topic"
    }
  ]
}
